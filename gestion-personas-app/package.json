{
  "name": "gestion-personas-tests",
  "version": "1.0.0",
  "description": "Test suite for Gestion Personas application",
  "private": true,
  "scripts": {
    "test": "npm run test:all",
    "test:all": "bash ./tests/scripts/test-runner.sh",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:coverage": "jest --coverage --coverageDirectory=./tests/results/coverage",
    "test:watch": "jest --watch",
    "test:e2e": "cd tests/e2e && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.2",
    "supertest": "^6.3.3"
  }
}
