# Database
DATABASE_URL=postgresql://admin:admin123@localhost:5432/personas_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Azure AI Foundry for NLP
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-endpoint.azure.com
AZURE_EMBEDDING_MODEL=text-embedding-ada-002
AZURE_CHAT_MODEL=gpt-4
AZURE_API_KEY=your-azure-api-key

# Flask
FLASK_SECRET_KEY=your-flask-secret-key-change-in-production

# Auth0 Configuration
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_CALLBACK_URL=http://localhost:8001/api/auth/login/auth0/callback

# Session Secret
SESSION_SECRET=your-session-secret-key-change-this-in-production

# Frontend
FRONTEND_URL=http://localhost:5000

# Services URLs (for local development)
AUTH_SERVICE_URL=http://localhost:3001
PERSONAS_SERVICE_URL=http://localhost:3002
CONSULTA_SERVICE_URL=http://localhost:3003
NLP_SERVICE_URL=http://localhost:3004
LOG_SERVICE_URL=http://localhost:3005
API_GATEWAY_URL=http://localhost:8001

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
