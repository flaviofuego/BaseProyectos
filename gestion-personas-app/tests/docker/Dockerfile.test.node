FROM node:18-alpine

WORKDIR /app

# Instalar herramientas de sistema necesarias
RUN apk add --no-cache \
    postgresql-client \
    curl \
    wget \
    jq \
    bash \
    git

# Copiar package.json de todos los servicios
COPY services/auth/package*.json /app/services/auth/
COPY services/personas/package*.json /app/services/personas/
COPY services/consulta/package*.json /app/services/consulta/
COPY services/nlp/package*.json /app/services/nlp/
COPY services/log/package*.json /app/services/log/
COPY gateway/package*.json /app/gateway/

# Instalar dependencias de todos los servicios
RUN cd /app/services/auth && npm ci && \
    cd /app/services/personas && npm ci && \
    cd /app/services/consulta && npm ci && \
    cd /app/services/nlp && npm ci && \
    cd /app/services/log && npm ci && \
    cd /app/gateway && npm ci

# Instalar herramientas de testing globales
RUN npm install -g \
    jest \
    @jest/core \
    jest-html-reporter \
    nyc

# Copiar código fuente
COPY services /app/services
COPY gateway /app/gateway

# Crear directorio para resultados de tests
RUN mkdir -p /app/test-results

# Script para ejecutar todos los tests
COPY test-runner.sh /app/test-runner.sh
RUN chmod +x /app/test-runner.sh

# Healthcheck
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD node --version || exit 1

CMD ["/app/test-runner.sh"]
