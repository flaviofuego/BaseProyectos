# ============================================================
# CONFIGURACIÓN DE PROVEEDOR DE IA
# ============================================================

# Proveedor de IA: 'gemini' o 'openai'
AI_PROVIDER=gemini

# ============================================================
# CONFIGURACIÓN PARA GOOGLE GEMINI
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=embedding-001

# ============================================================
# CONFIGURACIÓN PARA OPENAI
# ============================================================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ORGANIZATION=your_org_id_optional
# OPENAI_TEXT_MODEL=gpt-4-turbo-preview
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ============================================================
# CONFIGURACIÓN GENERAL DE IA (aplica a todos los proveedores)
# ============================================================
AI_TEMPERATURE=0.7
AI_TOP_K=40
AI_TOP_P=0.95
AI_MAX_TOKENS=2048

# ============================================================
# OTRAS CONFIGURACIONES DEL SERVICIO
# ============================================================
SERVICE_PORT=3004
DATABASE_URL=postgresql://user:password@postgres:5432/personas_db
QDRANT_URL=http://qdrant:6333
LOG_SERVICE_URL=http://log-service:3005
